<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AreaRistoratoreController">
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #618569;" BorderPane.alignment="CENTER">
         <children>
            <Button id="tastoLogout" mnemonicParsing="false" style="-fx-background-color: #618569;" translateX="20.0" translateY="25.0">
               <graphic>
                  <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../immagini/logout.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Label text="I  Miei Ristoranti" textFill="WHITE" translateX="50.0" translateY="25.0">
               <font>
                  <Font name="Georgia" size="40.0" />
               </font>
            </Label>
            <Region prefHeight="100.0" prefWidth="400.0" HBox.hgrow="ALWAYS" />
            <TextField prefHeight="47.0" prefWidth="429.0" promptText="Cerca per nome..." fx:id="ricerca" style="-fx-background-radius: 15;" translateX="-20.0" translateY="25.0">
               <font>
                  <Font size="20.0" />
               </font>
            </TextField>
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="514.0" prefWidth="1280.0" BorderPane.alignment="CENTER">
