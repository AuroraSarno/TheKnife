            <TilePane fx:id="grigliaRistoranti" alignment="TOP_CENTER" hgap="30.0" prefHeight="200.0" prefWidth="200.0" vgap="30.0" />
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="BOTTOM_RIGHT" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
         </BorderPane.margin>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Button id="aggRistoranti" mnemonicParsing="false" onAction="#btnAggRistorante" style="-fx-background-color: #618569; -fx-background-radius: 15;" text="+ Ristoranti" textFill="WHITE">
               <font>
                  <Font name="Trebuchet MS" size="25.0" />
               </font>
            </Button>
         </children>
